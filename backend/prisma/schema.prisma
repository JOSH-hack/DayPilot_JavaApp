// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  idUtilisateur Int       @id @default(autoincrement()) @map("id_utilisateur")
  nom           String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  motDePasse    String    @map("mot_de_passe") @db.VarChar(255)
  themePrefere  String?   @map("theme_prefere") @db.VarChar(50)
  
  // Nouvelles colonnes
  googleId      String?   @unique @map("google_id") @db.VarChar(255)
  photoUrl      String?   @map("photo_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastLogin     DateTime? @map("last_login")

  journees      Journee[]

  @@map("UTILISATEUR")
}

model Priorite {
  idPriorite Int       @id @default(autoincrement()) @map("id_priorite")
  libelle    String    @unique @db.VarChar(50)
  
  taches     Tache[]

  @@map("PRIORITE")
}

model Categorie {
  idCategorie Int       @id @default(autoincrement()) @map("id_categorie")
  nom         String    @unique @db.VarChar(100)
  couleur     String    @db.VarChar(20)
  
  taches      Tache[]

  @@map("CATEGORIE")
}

model Journee {
  idJournee     Int         @id @default(autoincrement()) @map("id_journee")
  dateJournee   DateTime    @db.Date @map("date_journee")
  
  idUtilisateur Int         @map("id_utilisateur")
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [idUtilisateur], onDelete: Cascade)
  
  taches        Tache[]

  @@unique([dateJournee, idUtilisateur])
  @@map("JOURNEE")
}

model Tache {
  idTache     Int       @id @default(autoincrement()) @map("id_tache")
  titre       String    @db.VarChar(150)
  description String?   @db.Text
  heureDebut  DateTime  @db.Time @map("heure_debut")
  heureFin    DateTime  @db.Time @map("heure_fin")
  statut      String    @default("en attente") @db.VarChar(30)
  
  // Nouvelle colonne
  difficulte  String?   @db.VarChar(50)

  idJournee   Int       @map("id_journee")
  journee     Journee   @relation(fields: [idJournee], references: [idJournee], onDelete: Cascade)
  
  idPriorite  Int       @map("id_priorite")
  priorite    Priorite  @relation(fields: [idPriorite], references: [idPriorite], onDelete: Restrict)
  
  idCategorie Int       @map("id_categorie")
  categorie   Categorie @relation(fields: [idCategorie], references: [idCategorie], onDelete: Restrict)

  rappels     Rappel[]

  @@unique([idJournee, heureDebut])
  @@map("TACHE")
}

model Rappel {
  idRappel    Int      @id @default(autoincrement()) @map("id_rappel")
  dateRappel  DateTime @db.Date @map("date_rappel")
  heureRappel DateTime @db.Time @map("heure_rappel")
  typeRappel  String   @map("type_rappel") @db.VarChar(50)
  actif       Boolean  @default(true)
  
  idTache     Int      @map("id_tache")
  tache       Tache    @relation(fields: [idTache], references: [idTache], onDelete: Cascade)

  @@unique([idTache, dateRappel, heureRappel])
  @@map("RAPPEL")
}
